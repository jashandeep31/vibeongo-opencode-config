{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "port": 4096
  },
  "permission": {
    "*": "allow"
  },
  "agent": {
    "build": {
      "mode": "primary",
      "prompt": "{file:./prompts/build.txt}"
    },
    "pr-reviewer": {
      "mode": "primary",
      "prompt": "{file:./prompts/pr-reviewer.txt}"
    },
    "issue-resolver": {
      "mode": "primary",
      "prompt": "{file:./prompts/issue-resolver.txt}"
    }
  },
  "mcp": {
    "agent-browser": {
      "type": "local",
      "command": ["agent-browser", "mcp"],
      "enabled": true
    },
    "vibeongo": {
      "type": "local",
      "command": ["vibeongo", "mcp"],
      "enabled": true
    }
  },
  "providers": {
    "vibeongo_ai": {
      "name": "Vibeongo AI",
      "env": ["VIBEONGO_AI_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://openrouter.ai/api/v1"
      },
      "models": {}
    }
  }
}
