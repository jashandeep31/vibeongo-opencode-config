{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "port": 4096
  },
  "permission": {
    "*": "allow"
  },
  "agent": {
    "pr-reviewer": {
      "mode": "primary",
      "prompt": "{file:./prompts/pr-reviewer.txt}"
    },
    "issue-resolver": {
      "mode": "primary",
      "prompt": "{file:./prompts/issue-resolver.txt}"
    }
  },
   "mcp": {
    "agent-browser": {
      "type": "local",
      "command": ["agent-browser", "mcp"],
      "enabled": true
    }
  }
}
